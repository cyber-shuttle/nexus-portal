# Template for local development env. Copy to .env.local and edit as needed.
#   cp .env.example .env.local
#
# .env.local is gitignored; .env.example is checked into git as the canonical
# template. Production env is generated by scripts/provision-vm.sh on the VM.

PORT=3000
HOSTNAME=127.0.0.1

# Auth mode: 'dev' uses the persona FAB (no real sign-in); 'oidc' requires
# the OIDC_* vars filled in (real Keycloak/CILogon flow).
PORTAL_AUTH_MODE=dev
NEXT_PUBLIC_PORTAL_AUTH_MODE=dev

# MSW seed data. Keep 'true' unless a real backend is running on the URLs
# below. Real backend integration is currently aspirational; MSW is the
# de-facto source of data for dev + e2e.
NEXT_PUBLIC_PORTAL_USE_MSW=true

# NextAuth session signing. Generate a real value with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-do-not-use-in-prod
NEXTAUTH_URL=http://localhost:3000

# Backend proxy targets (only hit when MSW=false).
CORE_API_BASE_URL=http://localhost:8080
AMIE_API_BASE_URL=http://localhost:8081
SIGNER_API_BASE_URL=http://localhost:8082

# --- OIDC mode (optional) -----------------------------------------------------
# Uncomment + fill all four to test the real auth flow locally. The schema
# fail-fast in src/lib/env.ts will refuse to boot if PORTAL_AUTH_MODE='oidc'
# and any of these are missing.
#
# OIDC_ISSUER_URL=https://auth.dev.cybershuttle.org/realms/default
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# NEXUS_ALLOWED_EMAILS=email1@example.org,email2@example.org

# --- Feedback widget (optional locally) ---------------------------------------
# Default path in production is per-user GitHub OAuth (see GITHUB_OAUTH_* below)
# — issues land attributed to the actual reporter, no bot token in the loop.
#
# In dev mode (NODE_ENV != 'production') the /api/feedback route short-circuits
# to a mock issue URL when no GitHub credential is available, so the UI flow
# works end-to-end without any token.
#
# FEEDBACK_GITHUB_TOKEN is an optional fallback that the route uses only when
# the caller has no GitHub session. Leave unset to require per-user attribution.
# If you do set one, mint at https://github.com/settings/personal-access-tokens/new
#   Repository: cyber-shuttle/nexus-portal (or your fork)
#   Permissions: Contents RW, Issues RW, Metadata R
#   Expiration: 90 days
#
# FEEDBACK_GITHUB_TOKEN=
# FEEDBACK_GITHUB_REPO=cyber-shuttle/nexus-portal
# FEEDBACK_LABEL=suggestion

# Optional: route screenshot commits to a dedicated branch instead of the
# repo's default. Keeps main's commit log clean. The branch MUST exist on
# the remote (Contents API won't create an orphan; it forks from HEAD).
# Create once via:
#   git mktree </dev/null | xargs -I{} git commit-tree {} -m "Init" | xargs git update-ref refs/heads/feedback-images
#   git push origin feedback-images
# FEEDBACK_IMAGES_BRANCH=feedback-images

# --- GitHub OAuth -------------------------------------------------------------
# Required for the default (PAT-free) feedback path. When a user clicks Submit
# without a github session, FeedbackPanel calls signIn("github") to redirect
# them through OAuth so the resulting issue is attributed to the submitter.
# The allowlist (NEXUS_ALLOWED_EMAILS) still gates admission — sign-in is
# admitted if ANY verified address on the GitHub account is in the allowlist.
#
# Register an OAuth app at https://github.com/settings/developers with the
# Authorization callback URL set to:
#   http://localhost:3000/api/auth/callback/github   (local)
#   https://<domain>/api/auth/callback/github        (prod)
#
# If FEEDBACK_GITHUB_REPO lives inside an organization that has OAuth App
# access restrictions enabled, the app must also be approved at the org level.
#
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Build SHA (auto-detected; override only for reproducible builds) --------
# next.config.ts runs `git rev-parse --short HEAD` at build time. Set this
# explicitly if you're building outside a git checkout (e.g., from a tarball).
# NEXT_PUBLIC_BUILD_SHA=
